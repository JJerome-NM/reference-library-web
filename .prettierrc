{
  "semi": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "bracketSameLine": true,
  "singleAttributePerLine": true,
  "arrowParens": "avoid",
  "printWidth": 120,
  "endOfLine": "lf",
  "tabWidth": 2,
  "trailingComma": "es5",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "packages/ui/src/styles/globals.css",
  "tailwindFunctions": ["cn", "cva"]
}
